# Copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used by the admin XML feed route. NEVER expose this
# with a NEXT_PUBLIC_ prefix, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sends the contact form email. Get a free key at resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Used for canonical URLs, sitemap.xml, robots.txt and the Spitogatos feed.
# Use your real domain (e.g. https://df-real-estate.com) in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
